@{
    ViewData["Title"] = "Video Processor";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            ```
            <div class="card shadow">
                <div class="card-body p-4">

                    <h2 class="text-center mb-4">
                        Video Processor
                    </h2>

                    <form asp-controller="Video"
                          asp-action="Upload"
                          method="post"
                          enctype="multipart/form-data">

                        <div class="mb-3">
                            <label for="video" class="form-label">
                                Select Video
                            </label>

                            <input type="file"
                                   class="form-control"
                                   id="video"
                                   name="video"
                                   accept="video/mp4" />
                        </div>

                        <div class="d-grid">
                            <button type="submit"
                                    class="btn btn-primary">
                                Upload & Process Video
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
    ```

</div>
